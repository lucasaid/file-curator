{
  "name": "file-curator",
  "version": "1.3.2",
  "description": "Generate list of files in a text file of directory",
  "keywords": [
    "files",
    "generator",
    "curator",
    "organisation",
    "organise"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasaid/file-curator.git"
  },
  "bugs": {
    "url": "https://github.com/lucasaid/file-curator/issues"
  },
  "files": [
    "lib/",
    "applescript/",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./lib/index.js",
  "scripts": {
    "prepare": "tsc -p .",
    "create": "pnpm run build && pnpm run test",
    "build": "tsc -p .",
    "refresh": "rm -rf ./node_modules ./pnpm-lock.yaml && pnpm install"
  },
  "author": "Chris Lucas",
  "license": "MIT",
  "bin": {
    "file-curator": "./lib/index.js"
  },
  "dependencies": {
    "columnify": "^1.6.0",
    "dateformat": "^3.0.3",
    "junk": "^2.1.0",
    "nodejs-fs-utils": "^1.2.6",
    "readline-sync": "^1.4.10",
    "word-wrap": "^1.2.5"
  },
  "devDependencies": {
    "@types/dateformat": "^3.0.1",
    "@types/junk": "^2.1.0",
    "@types/node": "^18.0.0",
    "@types/readline-sync": "^1.4.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
